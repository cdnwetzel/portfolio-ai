# Operator-local deploy targets. Copy to .deploy.env (gitignored) and fill in.
# The deploy and setup scripts read it when present; every value can also be set
# in the environment. Keep real host names and addresses out of the repository.
CLOUD_HOST=root@web.example.net      # the VPS that serves the site
T5810_HOST=root@jump.example.net     # route to the inference box (jump host or LAN address)
SVC_USER=user                        # login that owns the services on the boxes
